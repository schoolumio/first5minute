# ---------------------------------------------------------------------------
# Project Five - environment configuration. Copy to .env and fill in.
# NEVER commit real credentials. All secrets are read server-side only.
# ---------------------------------------------------------------------------

# General
ENVIRONMENT=development            # development | staging | production
FRONTEND_URL=http://localhost:3000 # used in email links and payment callbacks
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
SENTRY_DSN=

# Database & cache (docker-compose overrides these for its containers)
DATABASE_URL=postgresql+psycopg://five:five@localhost:5432/projectfive
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=five

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false                # must be true in production (HTTPS)
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Email: console (dev, prints links to the API log) | smtp (production)
EMAIL_BACKEND=console
EMAIL_FROM=Project Five <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Football data provider: demo (synthetic, clearly labelled) | api_football | sportmonks
FOOTBALL_PROVIDER=demo
API_FOOTBALL_KEY=                  # https://dashboard.api-football.com
API_FOOTBALL_REQUESTS_PER_MINUTE=30
SPORTMONKS_TOKEN=                  # https://my.sportmonks.com
SPORTMONKS_REQUESTS_PER_MINUTE=50

# Odds provider: none (no odds shown) | api_football
ODDS_PROVIDER=none

# Payments: none | paystack
PAYMENT_PROVIDER=none
PAYSTACK_SECRET_KEY=               # sk_test_... / sk_live_...  (webhook URL: <API>/api/v1/webhooks/paystack)

# Machine learning (Phase 3)
MODEL_DIR=./model_store            # trained model artifacts (joblib) - persist this volume in production
MLFLOW_TRACKING_URI=               # optional: sqlite:///mlflow.db or http://mlflow:5000 (needs requirements-ml.txt)
MLFLOW_EXPERIMENT=project-five
ML_MIN_OOS_SAMPLE=300              # out-of-sample matches required before a model can be promoted automatically

# Frontend (Next.js server-side proxy target)
BACKEND_URL=http://localhost:8000
